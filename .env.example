# =========================
# Server / Runtime
# =========================
# ARCHIMAP_IMAGE=archimap-local:dev
# For pull-based deploys set a published tag explicitly, for example:
# ARCHIMAP_IMAGE=streletskiy/archimap:1.2.3
# PORT=3252
# HOST=0.0.0.0
TRUST_PROXY=true
LOG_LEVEL=warn
METRICS_ENABLED=false

# =========================
# Security / Sessions
# =========================
SESSION_SECRET=change-me
# APP_BASE_URL=https://archimap.example.com
# APP_SETTINGS_SECRET=change-me
# REDIS_URL=redis://redis:6379
# SESSION_ALLOW_MEMORY_FALLBACK=true
# CSP_CONNECT_SRC_EXTRA=https://tiles.basemaps.cartocdn.com,https://*.basemaps.cartocdn.com,https://api.maptiler.com,https://overpass-api.de,https://lz4.overpass-api.de,https://z.overpass-api.de,https://maps.mail.ru,https://overpass.openstreetmap.fr,https://overpass.kumi.systems
# Custom basemap TileJSON and tile requests are proxied through same-origin routes, while sprite/glyph assets are served from local static files, so no custom basemap host needs to be added here.
# Session cookie `Secure` flag override:
# - true  : production behind HTTPS
# - false : local Docker/http:// (otherwise browser drops cookie and session looks "logged out")
# SESSION_COOKIE_SECURE=true

# =========================
# Database Paths
# =========================
DB_PROVIDER=postgres
# For local dev with SQLite:
# DB_PROVIDER=sqlite
DATABASE_URL=postgresql://archimap:archimap@db-postgres:5432/archimap
# SQLITE_URL=data/sqlite/archimap.db
# DATABASE_PATH=data/sqlite/archimap.db
# ARCHIMAP_DB_PATH=data/sqlite/archimap.db
# OSM_DB_PATH=data/sqlite/osm.db
# LOCAL_EDITS_DB_PATH=data/sqlite/local-edits.db
# USER_EDITS_DB_PATH=data/sqlite/user-edits.db
# USER_AUTH_DB_PATH=data/sqlite/users.db

# PostgreSQL / PostGIS (used when DB_PROVIDER=postgres)
# POSTGRES_HOST=db-postgres
# POSTGRES_PORT=5432
# POSTGRES_DB=archimap
# POSTGRES_USER=archimap
# POSTGRES_PASSWORD=archimap
# Search index rebuild tuning for PostgreSQL:
# SEARCH_INDEX_POSTGRES_CHUNKS=1

# =========================
# App Behavior
# =========================
# APP_DISPLAY_NAME=archimap
# Used only when URL and saved map position are absent.
# MAP_DEFAULT_LON=44.0059
# MAP_DEFAULT_LAT=56.3269
# MAP_DEFAULT_ZOOM=15
# USER_EDIT_REQUIRES_PERMISSION=true

# Registration / Password reset limits
# REGISTRATION_ENABLED=true
# REGISTRATION_CODE_TTL_MINUTES=15
# REGISTRATION_CODE_RESEND_COOLDOWN_SEC=60
# REGISTRATION_CODE_MAX_ATTEMPTS=6
# REGISTRATION_MIN_PASSWORD_LENGTH=8
# PASSWORD_RESET_TTL_MINUTES=60

# =========================
# Email / SMTP
# =========================
# SMTP_URL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=

# =========================
# OSM Import Source
# =========================
# Runtime region source config now lives only in Admin -> Data.
# There is no env-based region selector anymore.

# Importer progress
# PBF_PROGRESS_EVERY=10000
# PBF_PROGRESS_COUNT_PASS=true

# =========================
# Auto Sync / PMTiles
# =========================
# Runtime region schedule/PMTiles settings are stored in DB-backed data settings.
# These env vars are used only as server-side defaults for DB-backed region records.
# AUTO_SYNC_ENABLED=true
# AUTO_SYNC_ON_START=false
# AUTO_SYNC_INTERVAL_HOURS=168
# BUILDINGS_PMTILES_SOURCE_LAYER=buildings
# BUILDINGS_PMTILES_MIN_ZOOM=13
# BUILDINGS_PMTILES_MAX_ZOOM=16
# MAP_SELECTION_ATOMIC_DEBUG=false

# =========================
# PMTiles build tools
# =========================
# PMTILES_BUILD_ENGINE=planetiler
# PLANETILER_BIN=/absolute/path/to/planetiler
# TIPPECANOE_BIN=/absolute/path/to/tippecanoe
# TILE_JOIN_BIN=/absolute/path/to/tile-join
# ADMIN_REGIONS_PMTILES_ON_START=auto
# Default runtime path uses planetiler in a single pass. tippecanoe remains
# available as a fallback engine (`PMTILES_BUILD_ENGINE=tippecanoe`) and keeps
# the sharded/cached build path for large regions.
# TIPPECANOE_PROGRESS_JSON=true
# TIPPECANOE_PROGRESS_INTERVAL_SEC=5
# tippecanoe-only sharded build for multi-cell regions. Every region whose bbox
# spans more than one REGION_SYNC_SHARD_KM cell is split geographically: each
# shard runs tippecanoe separately, then tile-join merges the archives. This
# keeps peak tippecanoe memory bounded by the densest cell. Set
# REGION_SYNC_SHARD_KM=0 to fall back to a single tippecanoe pass when
# `PMTILES_BUILD_ENGINE=tippecanoe`.
# REGION_SYNC_SHARD_MIN_FEATURES is adaptive when unset; set it to 0 to force
# sharding for every multi-cell region or to a positive value to bias more
# regions onto the single-pass path.
# REGION_SYNC_SHARD_KM=60
# REGION_SYNC_SHARD_MIN_FEATURES=
# Workdir cleanup defaults to warm cache retention. Set to "aggressive" or
# "off" only if you explicitly want the old cleanup behavior.
# REGION_SYNC_WORKDIR_CLEANUP=warm
# REGION_SYNC_WORKDIR_CLEANUP_TTL_DAYS=14
# REGION_SYNC_WORKDIR_CLEANUP_MAX_BYTES=
# REGION_SYNC_RENDER_CACHE_REFRESH=false
# SQLite DB apply-stage batch size for `region-import.ndjson`. PostgreSQL full
# sync now loads the temp stage through COPY, so this only affects SQLite apply
# loop sizing and Postgres progress granularity.
# REGION_SYNC_IMPORT_APPLY_BATCH_SIZE=1000
# DuckDB export fetch size for region sync artifacts. Lower values reduce peak
# RSS during serialization; higher values may improve throughput on faster hosts.
# REGION_SYNC_EXPORT_BATCH_SIZE=2000
# Emit export-stage progress detail every N seconds without adding a full count
# pass. Useful for large PBF exports where a percentage would be misleading.
# REGION_SYNC_EXPORT_PROGRESS_INTERVAL_SEC=5
# DuckDB resource limits for the region sync extract stage.  These settings are
# propagated into both the inline DuckDB queries and QuackOSM's internal DuckDB
# connection, bounding peak memory during PBF-to-DuckDB extraction.
# On hosts with limited RAM (< 8 GB) set REGION_SYNC_DUCKDB_MEMORY_LIMIT to
# 60-75 % of free memory, e.g. "3GB" on a 4 GB device.
# When REGION_SYNC_DUCKDB_THREADS is unset, low-power 4-core ARM boards
# automatically default to 3 threads.
# REGION_SYNC_DUCKDB_MEMORY_LIMIT=3GB
# REGION_SYNC_DUCKDB_THREADS=3
# REGION_SYNC_DUCKDB_TEMP_DIRECTORY=/absolute/path/to/duckdb-tmp
#
# Low-memory sync pipeline (Postgres only).  Enabled by default: applies the
# database import first, then re-exports GeoJSON from the DB for the PMTiles
# build. Advantages over the standard (simultaneous dual-export) pipeline:
#   - DB import is safe even if the PMTiles build step later fails.
#   - Re-export from DB includes building_remainder rows, improving PMTiles quality.
# Set to "false" to revert to the original simultaneous dual-export pipeline
# (saves one extra DB read but requires more peak disk space).
# REGION_SYNC_LOW_MEMORY_PIPELINE=true
