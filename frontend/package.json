{
  "name": "archimap-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate:bootstrap": "node -e \"require('fs').rmSync('svelte.config.js', { force: true })\" && tsc -p ./tsconfig.theme-init.json && svelte-kit sync",
    "predev": "npm run generate:bootstrap",
    "prebuild": "npm run generate:bootstrap",
    "preanalyze": "npm run generate:bootstrap",
    "prepreview": "npm run generate:bootstrap",
    "precheck": "npm run generate:bootstrap",
    "dev": "vite dev --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "analyze": "vite build --mode analyze",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . --ext .ts,.svelte --max-warnings=0"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^0.577.0",
    "@sveltejs/adapter-node": "^6.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@typescript-eslint/types": "^8.72.1",
    "bits-ui": "^2.20.2",
    "clsx": "^2.1.1",
    "csstype": "^3.2.3",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "deepmerge": "file:./vendor/deepmerge"
  },
  "dependencies": {
    "@protomaps/basemaps": "^5.7.2",
    "archimap": "file:..",
    "maplibre-gl": "6.16.0",
    "marked": "^17.0.6",
    "osmtogeojson": "^3.0.0-beta.5",
    "pmtiles": "^4.5.0",
    "svelte-awesome-color-picker": "^4.1.3"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12",
    "deepmerge": "$deepmerge"
  },
  "packageManager": "npm@12.2.1"
}
